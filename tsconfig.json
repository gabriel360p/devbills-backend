{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": [
    "src"
  ], // Apenas os arquivos dentro da pasta `src` serão analisados
  "exclude": [
    "node_modules",
    "dist"
  ] // Ignora essas pastas durante a compilação
}
