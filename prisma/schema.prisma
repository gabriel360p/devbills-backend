generator client {
  //instruções para gerar o client. pnpm prisma generate 
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String  @unique
  name  String?
}

//utilizando enums
enum TransactionType {
  expense
  income
}

model Category {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  type         TransactionType
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now())
  color        String
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  description String
  amount      Float
  date        DateTime
  type        TransactionType
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())

  //relacionamentos no mongo db
  Category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String

  //agiliza querys:
  @@index([userId, date])
  @@index([userId, date, categoryId])
}
